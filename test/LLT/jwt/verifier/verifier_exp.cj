from std import collection.*
from std import time.*
from encoding import json.*
from jwt import jwt.algorithms.*
from jwt import jwt.impl.*
from jwt import jwt.exception.*
from jwt import jwt.interfaces.*
from jwt import jwt.*




// withExpiresAt 2023-01-16T13:44:50+08:00 
let token = "ewogICJrMSI6ICJ2MSIsCiAgImtpZCI6ICJrZXlJZCIsCiAgImFsZyI6ICJub25lIiwKICAidHlwIjogIkpXVCIKfQ.."

// 未设置 ExpiresAt
// let token = "ewogICJrMSI6ICJ2MSIsCiAgImtpZCI6ICJrZXlJZCIsCiAgImFsZyI6ICJub25lIiwKICAidHlwIjogIkpXVCIKfQ.."
main() {
   
  let require = JWT.require(Algorithm.none());
  try {
    require.acceptExpiresAt(11)

    let builder: JWTVerifier = require.build()
    builder.verify(token)

    return 1
  } catch (e2: TokenExpiredException){
    println(e2.getExpiredOn())
    println(e2.message)
    if (e2.message == "The Token has expired on 2023-01-16T10:11:30+08:00.") {
      return 0
    }
  } 
  1
}
